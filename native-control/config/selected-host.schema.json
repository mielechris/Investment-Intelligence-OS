{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "control_owner_id": {"minimum": 1, "type": "integer"},
    "control_ref": {"const": "refs/heads/main"},
    "control_repository": {"const": "mielechris/IIOS-Native-Control"},
    "control_repository_id": {"minimum": 1, "type": "integer"},
    "hardware_uuid": {"pattern": "^[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12}$", "type": "string"},
    "runner_name": {"maxLength": 64, "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$", "type": "string"},
    "schema": {"const": 3},
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "inventory_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "repository": {"const": "mielechris/Investment-Intelligence-OS"}
      },
      "required": ["repository", "commit", "inventory_sha256"],
      "type": "object"
    },
    "uid": {"minimum": 1, "type": "integer"},
    "workflow": {"const": "native-qualification.yml"}
  },
  "required": ["schema", "control_repository", "control_repository_id", "control_owner_id", "control_ref", "workflow", "source", "runner_name", "hardware_uuid", "uid"],
  "type": "object"
}
