(version 1)
(deny default)
(allow file-read-metadata)
(allow file-read* (subpath @RUNTIME@) (subpath @OUTPUT@)
  (subpath "/System/Library") (subpath "/usr/lib")
  (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random"))
(allow file-write* (subpath @OUTPUT@))
(allow process-exec (literal @INTERPRETER@))
(allow sysctl-read)
(allow network-outbound (remote ip @ENDPOINT@))
(allow network-inbound (local ip @ENDPOINT@))
(allow network-bind (local ip @ENDPOINT@))
