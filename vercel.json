{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "FRONT END/dist",
  "rewrites": [
    {
      "source": "/living/overview",
      "destination": "/api/living-overview"
    },
    {
      "source": "/living-wall/truth",
      "destination": "/api/living-wall-truth"
    },
    {
      "source": "/telemetry/ingest",
      "destination": "/api/telemetry-ingest"
    }
  ]
}
