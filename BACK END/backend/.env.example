# Core
OPENAI_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact information.
SEC_USER_AGENT=IIOS research your-email@example.com

# Optional live data providers
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
COINGECKO_DEMO_API_KEY=

# Continuous ingestion
IIOS_CRYPTO_ASSETS=bitcoin,ethereum
IIOS_EQUITY_SYMBOLS=SPY,QQQ,IWM,DIA,AAPL,MSFT,NVDA,AMZN,META
IIOS_SEC_IPO_INTERVAL_SECONDS=300
IIOS_SEC_COMPANY_INTERVAL_SECONDS=300
IIOS_CRYPTO_INTERVAL_SECONDS=60
IIOS_EQUITY_INTERVAL_SECONDS=900
IIOS_FRED_INTERVAL_SECONDS=1800

# Unattended model processing is opt-in.
IIOS_AUTO_RUN_AGENTS=false
IIOS_AUTO_RUN_MAX_PER_CYCLE=5
IIOS_AUTO_RUN_COMMITTEE=false
IIOS_AUTO_RUN_COMMITTEE_MAX_PER_CYCLE=3
IIOS_COMMITTEE_CONFIDENCE_THRESHOLD=0.70
IIOS_AUTO_RUN_RISK=false
IIOS_AUTO_RUN_RISK_MAX_PER_CYCLE=3

# Docker Compose overrides this to the persistent volume path.
IIOS_DB_PATH=/data/iios.db
